         paints the window in the page colour so there is no flash before the first frame. -->
    <style name="Theme.ReleaseFlow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F7F7</item>
    </style>
</resources>
